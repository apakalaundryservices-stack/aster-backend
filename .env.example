# Copy to .env for local development. Replace placeholders before use.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aster_suites
POSTGRES_USER=aster_dev
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://aster_dev:replace-with-a-random-local-password@localhost:5433/aster_suites?schema=public

# Generate a random secret for local development; never commit .env.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=aster_session
ADMIN_EMAIL=admin@aster.local
ADMIN_PASSWORD=replace-with-a-long-local-password
STAFF_EMAIL=staff@aster.local
STAFF_PASSWORD=replace-with-a-long-local-password

# Google OAuth web-client credentials. Register this exact redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Daraja sandbox placeholders. Do not put real credentials in this file.
PAYMENT_MODE=BOTH
MPESA_MODE=sandbox
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORTCODE=replace-me
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_BASE_URL=https://replace-with-your-ngrok-host
MPESA_CALLBACK_TOKEN=replace-with-a-random-token

# Optional SMTP settings for local notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
